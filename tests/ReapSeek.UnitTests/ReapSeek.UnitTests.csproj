    <Authors>Guven Imat</Authors>
    <Copyright>Copyright 2026 Guven Imat</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/guvenimat/ReapSeek</RepositoryUrl>
